---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Juan Manuel Rojas Rojas — Desarrollador Full-Stack",
  description = "Soy técnico en Programación de Software y estudiante de Tecnología en Análisis y Desarrollo de Software. Desarrollo aplicaciones web, APIs y soluciones orientadas a la gestión de datos y la lógica de negocio.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0c0e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-ink font-sans text-paper antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-sm focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-ink"
    >
      Saltar al contenido
    </a>

    <slot name="header" />

    <main id="contenido" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>

    <slot name="footer" />

    <script>
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduceMotion) {
        const lenis = new Lenis({
          lerp: 0.1,
          smoothWheel: true,
          anchors: true,
        });

        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };

        requestAnimationFrame(raf);
      }
    </script>
  </body>
</html>
