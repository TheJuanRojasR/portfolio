---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = "Juan Manuel Rojas Rojas — Desarrollador Full-Stack",
  description = "Soy técnico en Programación de Software y estudiante de Análisis y Desarrollo de Software. Construyo aplicaciones web, APIs y soluciones de gestión de datos.",
  type = "website",
  jsonLd,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, site);
const homeURL = new URL(base, site);
const ogImageURL = new URL(`${base}images/og-image.jpg`, site);
const portraitURL = new URL(`${base}images/portrait.webp`, site);
const ogImageAlt = "Juan Manuel Rojas Rojas, desarrollador full-stack";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Juan Manuel Rojas Rojas",
  jobTitle: "Desarrollador Full-Stack",
  url: homeURL.toString(),
  image: portraitURL.toString(),
  email: "jumanuelro.14@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bogotá",
    addressCountry: "CO",
  },
  sameAs: [
    "https://github.com/TheJuanRojasR",
    "https://www.linkedin.com/in/juan-manuel-rojas-rojas/",
  ],
  knowsAbout: [
    "JavaScript",
    "TypeScript",
    "Node.js",
    "Java",
    "Spring Boot",
    "React",
    "PostgreSQL",
    "MongoDB",
    "Docker",
    "AWS",
  ],
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Juan Manuel Rojas Rojas",
  url: homeURL.toString(),
  inLanguage: "es",
};

const structuredData = [
  person,
  website,
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Juan Manuel Rojas Rojas" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0c0e" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon-jm.svg`} />
    <link rel="icon" href={`${base}favicon-jm.ico`} sizes="any" />
    <link rel="canonical" href={canonicalURL.toString()} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Juan Manuel Rojas Rojas" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:image" content={ogImageURL.toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.toString()} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {structuredData.map((data) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(data).replace(/</g, "\\u003c")}
      />
    ))}
    <title>{title}</title>
  </head>
  <body class="min-h-dvh font-sans text-paper antialiased">
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 bg-ink">
      <div class="page-grid absolute inset-0"></div>
      <div class="page-stars absolute inset-0"></div>
      <div
        class="page-stars-dense absolute inset-0"
        style={`--stars-dense: url("${base}images/stars-dense.svg")`}
      ></div>
      <div class="page-grain absolute inset-0"></div>
    </div>

    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-sm focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-ink"
    >
      Saltar al contenido
    </a>

    <slot name="header" />

    <main id="contenido" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>

    <slot name="footer" />

    <script>
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reduceMotion) {
        const lenis = new Lenis({
          lerp: 0.1,
          smoothWheel: true,
          anchors: true,
        });

        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };

        requestAnimationFrame(raf);
      }
    </script>
  </body>
</html>
