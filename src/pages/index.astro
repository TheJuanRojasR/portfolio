---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";

const sections = [
  {
    id: "proyectos",
    number: "01",
    label: "Proyectos",
    heading: "Proyectos seleccionados",
    placeholder: "Próximamente: casos de estudio con problema, decisiones y resultados.",
  },
  {
    id: "sobre-mi",
    number: "02",
    label: "Sobre mí",
    heading: "Sobre mí",
    placeholder: "Próximamente: trayectoria, formación y forma de trabajo.",
  },
  {
    id: "contacto",
    number: "03",
    label: "Contacto",
    heading: "Contacto",
    placeholder: "Próximamente: canales de contacto y CV.",
  },
];
---

<BaseLayout>
  <Header slot="header" />

  <Hero />

  {
    sections.map((section) => (
      <section
        id={section.id}
        aria-labelledby={`${section.id}-titulo`}
        class="scroll-mt-16 border-t border-line"
      >
        <div
          class="mx-auto grid w-full max-w-site grid-cols-1 gap-x-8 gap-y-6 px-6 py-24 md:px-10 md:py-32 lg:grid-cols-12"
        >
          <p class="font-mono text-xs tracking-[0.14em] text-muted uppercase lg:col-span-3">
            <span class="text-accent">{section.number}</span>
            <span aria-hidden="true"> / </span>
            {section.label}
          </p>

          <div class="min-w-0 lg:col-span-9">
            <h2
              id={`${section.id}-titulo`}
              class="text-3xl font-semibold tracking-[-0.02em] text-paper sm:text-4xl"
            >
              {section.heading}
            </h2>
            <p class="mt-5 max-w-xl text-base leading-relaxed text-muted">
              {section.placeholder}
            </p>
          </div>
        </div>
      </section>
    ))
  }

  <Footer slot="footer" />
</BaseLayout>
