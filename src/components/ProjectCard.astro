---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
}

const { project, index } = Astro.props;
const { data } = project;
const base = import.meta.env.BASE_URL;
const number = `0${index + 1}`;
const isProduction = data.status.toLowerCase().includes("producción");
const arrow = "M3 7h8M7.5 3.5 11 7l-3.5 3.5";
---

<a
  href={`${base}proyectos/${project.id}/`}
  class="group relative flex h-full min-w-0 flex-col overflow-hidden rounded-md border border-line bg-surface p-5 transition-colors duration-300 hover:border-accent/40 focus-visible:border-accent/40 sm:p-6 md:p-8 motion-reduce:transition-none"
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-paper/[0.02] opacity-0 transition-opacity duration-300 group-hover:opacity-100 motion-reduce:transition-none"
  ></span>
  <span
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-accent transition-transform duration-500 ease-out group-hover:scale-x-100 motion-reduce:transition-none"
  ></span>

  <div class="relative flex flex-1 flex-col">
    <div class="flex items-start justify-between gap-4">
      <span class="font-mono text-xs tracking-[0.14em] text-muted">{number}</span>
      <span
        class:list={[
          "rounded-sm border px-2 py-1 font-mono text-xs whitespace-nowrap",
          isProduction ? "border-accent/40 text-accent" : "border-line text-muted",
        ]}
      >
        {data.status}
      </span>
    </div>

    <h3 class="mt-8 text-2xl font-semibold tracking-tight text-paper break-words md:text-3xl">
      {data.title}
    </h3>

    <p class="mt-4 text-sm leading-relaxed text-muted md:text-[15px]">
      {data.summary}
    </p>

    <ul class="mt-6 flex flex-wrap gap-2" aria-label="Stack">
      {
        data.stack.map((tech) => (
          <li class="rounded-sm border border-line px-2 py-1 font-mono text-[11px] text-muted">
            {tech}
          </li>
        ))
      }
    </ul>

    <div class="mt-auto pt-10">
      <div class="grid grid-cols-3 gap-3 border-t border-line pt-6 sm:gap-4">
        {
          data.metrics.map((metric) => (
            <div class="min-w-0">
              <p class="text-base font-semibold text-paper break-words sm:text-xl">{metric.value}</p>
              <p class="mt-1 font-mono text-[11px] tracking-[0.14em] text-muted uppercase">
                {metric.label}
              </p>
            </div>
          ))
        }
      </div>

      <span
        class="mt-6 inline-flex items-center gap-2.5 font-mono text-xs text-paper transition-colors duration-300 group-hover:text-accent motion-reduce:transition-none"
      >
        Ver caso
        <svg
          aria-hidden="true"
          viewBox="0 0 14 14"
          class="size-3.5 transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none"
        >
          <path
            d={arrow}
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
    </div>
  </div>
</a>
