---
const arrow = "M3 7h8M7.5 3.5 11 7l-3.5 3.5";
const mailto =
  "mailto:jumanuelro.14@gmail.com?subject=Hola%20Juanma%20-%20Contacto%20desde%20tu%20portafolio";
---

<section
  id="contacto"
  aria-labelledby="contacto-titulo"
  class="scroll-mt-16 border-t border-line"
>
  <div class="mx-auto w-full max-w-site px-6 py-24 md:px-10 md:py-32">
    <h2
      id="contacto-titulo"
      class="font-mono text-xs tracking-[0.14em] text-muted uppercase"
    >
      <span class="text-accent">03</span>
      <span aria-hidden="true"> / </span>
      Contacto
    </h2>

    <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-x-8">
      <div class="min-w-0 lg:col-span-7">
        <p
          class="text-4xl leading-[1.05] font-semibold tracking-[-0.03em] text-balance text-paper sm:text-5xl"
        >
          Hablemos
        </p>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-muted">
          Cuéntame qué necesitas y te respondo. Puede ser una vacante, un
          proyecto o simplemente una charla.
        </p>
      </div>

      <div class="min-w-0 lg:col-span-5">
        <a
          href={mailto}
          class="group inline-flex max-w-full items-center gap-3 text-2xl font-semibold tracking-[-0.02em] text-muted transition-colors hover:text-paper sm:text-3xl"
        >
          <span class="break-all">jumanuelro.14@gmail.com</span>
          <svg
            aria-hidden="true"
            viewBox="0 0 14 14"
            class="size-5 shrink-0 transition-transform duration-300 group-hover:translate-x-1 motion-reduce:transition-none"
          >
            <path
              d={arrow}
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>

        <div class="mt-5 flex items-center gap-3">
          <button
            type="button"
            data-copy-email="jumanuelro.14@gmail.com"
            class="rounded-sm border border-line px-2.5 py-1 font-mono text-[11px] text-muted transition-colors hover:border-accent hover:text-accent"
          >
            Copiar correo
          </button>
          <span data-copy-status class="sr-only" aria-live="polite"></span>
        </div>
        
      </div>
    </div>

  </div>
</section>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");

  if (copyButton) {
    const originalLabel = copyButton.textContent;

    const showCopied = () => {
      copyButton.textContent = "Copiado";
      if (copyStatus) copyStatus.textContent = "Correo copiado";
      window.setTimeout(() => {
        copyButton.textContent = originalLabel;
        if (copyStatus) copyStatus.textContent = "";
      }, 2000);
    };

    copyButton.addEventListener("click", async () => {
      const email = copyButton.dataset.copyEmail;
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);
        showCopied();
      } catch {
        const textarea = document.createElement("textarea");
        textarea.value = email;
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand("copy");
        document.body.removeChild(textarea);
        showCopied();
      }
    });
  }
</script>
