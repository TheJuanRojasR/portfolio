        class="hero-rise font-mono text-xs tracking-[0.14em] text-muted uppercase"
        style="--delay: 0ms"
      >
        Bogotá, Colombia
      </p>

      <h1
        id="hero-titulo"
        class="hero-rise mt-6 text-4xl leading-[1.08] font-semibold tracking-[-0.03em] text-balance text-paper sm:text-5xl lg:text-[3.4rem]"
        style="--delay: 80ms"
