            </svg>
            LinkedIn
          </span>
          <span class="text-sm text-paper transition-colors group-hover:text-accent">
            Juan Manuel Rojas Rojas
          </span>
        </a>

        <a
          href="https://github.com/TheJuanRojasR"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col gap-1 py-4 transition-colors sm:px-6"
        >
          <span class="flex items-center gap-2 font-mono text-[11px] tracking-[0.1em] text-muted uppercase">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="size-3.5 text-accent"
              fill="currentColor"
            >
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.93.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
            </svg>
