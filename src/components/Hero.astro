---
const arrow = "M3 7h8M7.5 3.5 11 7l-3.5 3.5";
---

<div class="relative isolate overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
    <div class="hero-glow absolute inset-0"></div>
    <div class="hero-grid absolute inset-0"></div>
    <div class="hero-grain absolute inset-0"></div>
  </div>

  <section
    aria-labelledby="hero-titulo"
  class="mx-auto grid min-h-[calc(100svh-4rem)] w-full max-w-site grid-cols-1 items-start gap-x-8 gap-y-14 px-6 pt-16 pb-16 md:px-10 md:pt-14 md:pb-16 lg:grid-cols-12 lg:items-center"
>
