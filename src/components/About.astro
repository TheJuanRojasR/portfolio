---
const stats = [
  { value: "2+", label: "Años de experiencia" },
  { value: "4", label: "Proyectos reales" },
  { value: "2", label: "En producción" },
  { value: "1", label: "En desarrollo" },
];

const skillGroups = [
  {
    label: "Backend",
    items: ["Node.js", "Express", "Java", "Spring Boot", "APIs REST", "JWT"],
  },
  {
    label: "Datos",
    items: ["PostgreSQL", "MySQL", "MongoDB", "Prisma"],
  },
  {
    label: "Frontend",
    items: ["React", "JavaScript", "TypeScript", "Tailwind CSS", "HTML/CSS"],
  },
  {
    label: "DevOps y herramientas",
    items: [
      "Docker",
      "Linux",
      "AWS EC2",
      "Git/GitHub",
      "Postman",
      "Figma",
      "Jest/Vitest",
    ],
  },
];

const education = [
  {
    period: "2018",
    title: "Tecnólogo en Mecatrónica",
    detail: "SENA.",
    short: "Mecatrónica",
    certification: false,
  },
  {
    period: "2025",
    title: "Técnico en Programación de Software",
    detail: "SENA.",
    short: "Técnico",
    certification: false,
  },
  {
    period: "2025",
    title: "Formación Full Stack",
    detail: "SGS Academy COLCAM.",
    short: "Full Stack",
    certification: false,
  },
  {
    period: "2025",
    title: "JavaScript Certified Associate",
    detail: "Certiplus.",
    short: "Certiplus",
    certification: true,
  },
  {
    period: "En curso",
    title: "Tecnólogo en Análisis y Desarrollo de Software",
    detail: "SENA.",
    short: "En curso",
    certification: false,
  },
];
---

<section
  id="sobre-mi"
  aria-labelledby="sobre-mi-titulo"
  class="scroll-mt-16 border-t border-line"
>
  <div class="mx-auto w-full max-w-site px-6 py-24 md:px-10 md:py-32">
    <h2
      id="sobre-mi-titulo"
      class="font-mono text-xs tracking-[0.14em] text-muted uppercase"
    >
      <span class="text-accent">01</span>
      <span aria-hidden="true"> / </span>
      Sobre mí
    </h2>

    <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-x-8">
      <div class="min-w-0 lg:col-span-7">
        <p
          class="text-4xl leading-[1.05] font-semibold tracking-[-0.03em] text-balance text-paper sm:text-5xl"
        >
          Hola, gente. Soy <span class="text-accent">Juan Manuel Rojas Rojas</span>
        </p>
        <div class="mt-6 max-w-2xl space-y-5 text-base leading-relaxed text-muted">
          <p>
            Soy técnico en Programación de Software y estoy en el último semestre
            de Análisis y Desarrollo de Software. Me gusta construir aplicaciones
            web siguiendo el ciclo de vida del software: entender el problema,
            ordenar la estructura y entregar algo robusto.
          </p>
          <p>
            Antes de implementar, intento tener todo ordenado y estructurado; eso
            me facilita el desarrollo y el mantenimiento. Disfruto conversar con
            mis compañeros y comunicarme con asertividad y empatía. Para mí, la
            comunicación es la herramienta más importante de este sector.
          </p>
        </div>
      </div>

      <div class="min-w-0 lg:col-span-5">
        <div class="grid grid-cols-2">
          {
            stats.map((stat, index) => (
              <div
                class={`p-5 sm:p-6 ${index % 2 === 1 ? "border-l border-line" : ""} ${index >= 2 ? "border-t border-line" : ""}`}
              >
                <p class="text-5xl font-semibold tracking-[-0.03em] text-accent sm:text-6xl">
                  {stat.value}
                </p>
                <p class="mt-2 font-mono text-[11px] leading-relaxed tracking-[0.1em] text-muted uppercase">
                  {stat.label}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-16 border-t border-line pt-12">
      <h3 class="font-mono text-xs tracking-[0.14em] text-muted uppercase">
        Stack
      </h3>
      <div class="mt-8 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {
          skillGroups.map((group) => (
            <div class="min-w-0">
              <h3 class="font-mono text-xs tracking-[0.14em] text-muted uppercase">
                {group.label}
              </h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <li class="rounded-sm border border-line px-2 py-1 font-mono text-[11px] text-muted">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div id="formacion" class="mt-16 scroll-mt-16 border-t border-line pt-12">
      <h3 class="font-mono text-xs tracking-[0.14em] text-muted uppercase">
        Formación y certificaciones
      </h3>

      <div data-timeline class="mt-8">
        <div class="snap-x overflow-x-auto pb-2">
          <div
            data-timeline-track
            class="relative min-w-max lg:min-w-0"
          >
            <div
              aria-hidden="true"
              class="absolute inset-x-0 top-6 h-px bg-line"
            >
            </div>
            <div
              aria-hidden="true"
              class="timeline-line absolute inset-x-0 top-6 h-px origin-left bg-accent"
            >
            </div>

            <div
              data-timeline-arrow
              class="timeline-arrow pointer-events-none absolute bottom-0 left-0 z-10 text-accent"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 16 16"
                class="size-4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M8 14V4M4 8l4-4 4 4" />
              </svg>
            </div>

            <ol class="relative flex gap-4 pb-7 lg:grid lg:grid-cols-5 lg:gap-8">
              {
                education.map((item, index) => (
                  <li
                    class="timeline-point min-w-[5.5rem] flex-1 snap-start lg:min-w-0"
                    style={`--index:${index}`}
                  >
                    <button
                      type="button"
                      class="timeline-point-button group relative flex w-full cursor-pointer flex-col items-center pt-10"
                      data-timeline-point
                      aria-controls={`timeline-panel-${index}`}
                      aria-pressed={index === 0}
                      aria-label={`${item.period}: ${item.title}, ${item.detail}`}
                    >
                      <span
                        class="timeline-dot absolute top-6 left-1/2 size-2.5 rounded-full border border-accent/40 bg-ink"
                        aria-hidden="true"
                      />
                      <span class="timeline-point-label font-mono text-[11px] text-muted">
                        {item.short}
                      </span>
                    </button>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>

        <div
          class="mt-4 min-h-[4.5rem]"
          aria-live="polite"
        >
          {
            education.map((item, index) => (
              <div
                id={`timeline-panel-${index}`}
                data-timeline-panel
                hidden={index !== 0}
                class="timeline-panel flex flex-col items-center text-center"
              >
                <p class="font-mono text-xs tracking-[0.04em] text-accent">
                  {item.period}
                </p>
                <div class="mt-2 flex flex-wrap items-center justify-center gap-2">
                  <p class="text-lg font-semibold text-paper">
                    {item.title}
                  </p>
                  {item.certification && (
                    <span class="rounded-sm border border-accent/40 px-2 py-0.5 font-mono text-[10px] tracking-[0.08em] text-accent uppercase">
                      Certificación
                    </span>
                  )}
                </div>
                <p class="mt-1 text-sm text-muted">{item.detail}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<noscript>
  <style>
    [data-timeline] .timeline-line,
    [data-timeline] .timeline-point,
    [data-timeline] .timeline-dot {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    [data-timeline] .timeline-line {
      transform: scaleX(1) !important;
    }

    [data-timeline] .timeline-dot {
      transform: translate(-50%, -50%) scale(1) !important;
    }
  </style>
</noscript>

<style>
  [data-timeline] .timeline-line {
    transform: scaleX(0);
    transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-timeline].is-visible .timeline-line {
    transform: scaleX(1);
  }

  [data-timeline] .timeline-point {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 500ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(180ms + var(--index) * 90ms);
  }

  [data-timeline].is-visible .timeline-point {
    opacity: 1;
    transform: none;
  }

  [data-timeline] .timeline-dot {
    transform: translate(-50%, -50%) scale(0);
    transition:
      transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
    transition-delay: calc(180ms + var(--index) * 90ms);
  }

  [data-timeline].is-visible .timeline-dot {
    transform: translate(-50%, -50%) scale(1);
  }

  [data-timeline] .timeline-point-button.is-active .timeline-dot {
    border-color: var(--accent);
    background-color: var(--accent);
    box-shadow: 0 0 0 4px rgb(244 184 96 / 0.12);
    transform: translate(-50%, -50%) scale(1.2);
  }

  [data-timeline] .timeline-point-label {
    transition: color 200ms ease;
  }

  [data-timeline] .timeline-point-button.is-active .timeline-point-label {
    color: var(--paper);
  }

  [data-timeline] .timeline-arrow {
    opacity: 0;
    transition:
      opacity 300ms ease,
      transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-timeline].is-visible .timeline-arrow {
    opacity: 1;
  }

  .timeline-panel.panel-in {
    animation: panel-in 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-timeline] .timeline-line,
    [data-timeline] .timeline-point,
    [data-timeline] .timeline-dot,
    [data-timeline] .timeline-arrow {
      opacity: 1;
      transition: none;
    }

    [data-timeline] .timeline-line {
      transform: scaleX(1);
    }

    [data-timeline] .timeline-point {
      transform: none;
    }

    [data-timeline] .timeline-dot {
      transform: translate(-50%, -50%) scale(1);
    }

    [data-timeline] .timeline-arrow {
      opacity: 1;
    }

    .timeline-panel.panel-in {
      animation: none;
    }
  }

  @media (max-width: 551px) {
    [data-timeline] .snap-x {
      overflow-x: visible;
      scroll-snap-type: none;
    }

    [data-timeline] [data-timeline-track] {
      min-width: 0;
    }

    [data-timeline] [data-timeline-track] > div[aria-hidden="true"] {
      display: none;
    }

    [data-timeline] ol {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0;
      padding-bottom: 0;
    }

    [data-timeline] ol::before {
      content: "";
      position: absolute;
      top: 0.75rem;
      bottom: 0.75rem;
      left: 0;
      width: 1px;
      background: var(--line);
    }

    [data-timeline] .timeline-point {
      min-width: 0;
      flex: none;
    }

    [data-timeline] .timeline-point-button {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      padding: 0.75rem 0 0.75rem 1.5rem;
    }

    [data-timeline] .timeline-dot {
      top: 50%;
      left: 0;
    }

    [data-timeline] .timeline-point-label {
      text-align: left;
    }

    [data-timeline] .timeline-panel {
      align-items: flex-start;
      text-align: left;
    }

    [data-timeline] .timeline-panel > div {
      justify-content: flex-start;
    }
  }
</style>

<script>
  const timelines = document.querySelectorAll<HTMLElement>("[data-timeline]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  timelines.forEach((timeline) => {
    const track = timeline.querySelector<HTMLElement>("[data-timeline-track]");
    const arrow = timeline.querySelector<HTMLElement>("[data-timeline-arrow]");
    const points = Array.from(
      timeline.querySelectorAll<HTMLButtonElement>("[data-timeline-point]"),
    );
    const panels = Array.from(
      timeline.querySelectorAll<HTMLElement>("[data-timeline-panel]"),
    );

    if (!track || !arrow || points.length === 0) return;

    let activeIndex = 0;

    const positionArrow = () => {
      const point = points[activeIndex];
      const trackRect = track.getBoundingClientRect();
      const pointRect = point.getBoundingClientRect();
      const x = pointRect.left - trackRect.left + pointRect.width / 2;
      arrow.style.transform = `translateX(${x}px) translateX(-50%)`;
    };

    const setActive = (index: number, animate = true) => {
      activeIndex = index;

      points.forEach((point, pointIndex) => {
        const isActive = pointIndex === index;
        point.classList.toggle("is-active", isActive);
        point.setAttribute("aria-pressed", String(isActive));
      });

      panels.forEach((panel, panelIndex) => {
        const isActive = panelIndex === index;
        panel.hidden = !isActive;
        panel.classList.remove("panel-in");

        if (isActive && animate && !reduceMotion) {
          void panel.offsetWidth;
          panel.classList.add("panel-in");
        }
      });

      positionArrow();
    };

    points.forEach((point, index) => {
      point.addEventListener("mouseenter", () => setActive(index));
      point.addEventListener("focus", () => setActive(index));
      point.addEventListener("click", () => setActive(index));
    });

    window.addEventListener("resize", positionArrow);

    if ("ResizeObserver" in window) {
      const resizeObserver = new ResizeObserver(positionArrow);
      resizeObserver.observe(track);
    }

    document.fonts?.ready.then(positionArrow);

    setActive(activeIndex, false);

    if (reduceMotion) {
      timeline.classList.add("is-visible");
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            timeline.classList.add("is-visible");
            setActive(activeIndex, true);
            observer.disconnect();
            break;
          }
        }
      },
      { threshold: 0.2 },
    );

    observer.observe(timeline);
  });
</script>
